# Copie para .env. Tudo e opcional: sem chave o modulo roda em modo mock.
FIRECRAWL_API_KEY=
RESEND_API_KEY=
ABACATEPAY_API_KEY=
USER_EMAIL=
OBSIDIAN_VAULT_PATH=~/AIWikiVault
# backup do vault em um repositorio PRIVADO do usuario (usado por obsidian.py --git-backup)
# ex: git@github.com:usuario/meu-vault.git
VAULT_GIT_REMOTE=
# mock | claude | local
DIAG_BACKEND=mock
# modelo local para DIAG_BACKEND=local: pasta do adapter LoRA (outputs/wreinforce) ou id/caminho HF
LOCAL_MODEL=
# modelo base do adapter (o mesmo usado no treino)
LOCAL_BASE_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# alias do modelo Claude usado pelo llm.py (haiku | sonnet | opus)
LLM_MODEL=haiku
