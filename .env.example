# Copie para .env. Tudo e opcional: sem chave o modulo roda em modo mock.
FIRECRAWL_API_KEY=
RESEND_API_KEY=
ABACATEPAY_API_KEY=
USER_EMAIL=
OBSIDIAN_VAULT_PATH=~/AIWikiVault
# backup do vault em um repositorio PRIVADO do usuario (usado por obsidian.py --git-backup)
# ex: git@github.com:usuario/meu-vault.git
VAULT_GIT_REMOTE=
# mock | claude | small
DIAG_BACKEND=mock
# modelo treinado (W-REINFORCE) servido via vLLM com API OpenAI, usado em DIAG_BACKEND=small
# ex: http://IP-DA-GPU:8000
SMALL_MODEL_URL=
# nome do modelo no servidor vLLM
SMALL_MODEL_NAME=cognitive
# opcional: Bearer token se o servidor exigir
SMALL_MODEL_API_KEY=
# alias do modelo Claude usado pelo llm.py (haiku | sonnet | opus)
LLM_MODEL=haiku
